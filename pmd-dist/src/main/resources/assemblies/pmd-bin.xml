<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.1 https://maven.apache.org/xsd/assembly-2.1.1.xsd">

    <id>bin</id>
    <formats>
        <format>zip</format>
    </formats>

    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${pmd.dist.bin.baseDirectory}</baseDirectory>

    <fileSets>
        <fileSet>
            <includes>
                <include>pmd.bat</include>
            </includes>
            <directory>target/extra-resources/scripts</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
            <directoryMode>0755</directoryMode>
            <lineEnding>dos</lineEnding>
        </fileSet>

        <fileSet>
            <includes>
                <include>pmd</include>
            </includes>
            <directory>target/extra-resources/scripts</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
            <directoryMode>0755</directoryMode>
            <lineEnding>unix</lineEnding>
        </fileSet>

        <fileSet>
            <includes>
                <include>LICENSE</include>
            </includes>
            <directory>target/extra-resources</directory>
            <outputDirectory>.</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0644</fileMode>
        </fileSet>

        <fileSet>
            <includes>
                <include>simplelogger.properties</include>
            </includes>
            <directory>target/extra-resources/conf</directory>
            <outputDirectory>conf</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0644</fileMode>
        </fileSet>

        <fileSet>
            <includes>
                <include>pmd-*-cyclonedx.xml</include>
                <include>pmd-*-cyclonedx.json</include>
            </includes>
            <directory>target</directory>
            <outputDirectory>sbom</outputDirectory>
        </fileSet>
    </fileSets>

    <dependencySets>
        <!-- jar dependencies that are valid modules (named or automatic) go to lib/modules/ -->
        <dependencySet>
            <scope>runtime</scope>
            <excludes>
                <exclude>net.sourceforge.pmd:pmd-languages-deps:pom</exclude>

                <!-- exclude pmd-ant. While it is a module, it won't work, because its dependencies
                     ant.jar/ant-launcher.jar are missing
                -->
                <exclude>net.sourceforge.pmd:pmd-ant</exclude>

                <!-- exclude dependencies not ready for module path yet -->
                <exclude>io.github.apex-dev-tools:apex-ls_2.13</exclude>
                <exclude>com.github.pathikrit:better-files_2.13</exclude>
                <exclude>org.scalameta:common_2.13</exclude>
                <exclude>org.scalameta:common2_2.13</exclude>
                <exclude>io.methvin:directory-watcher-better-files_2.13</exclude>
                <exclude>com.lihaoyi:geny_2.13</exclude>
                <exclude>org.scalameta:io_2.13</exclude>
                <exclude>com.lihaoyi:mainargs_2.13</exclude>
                <exclude>io.github.apex-dev-tools:outline-parser_2.13</exclude>
                <exclude>org.scalameta:parsers_2.13</exclude>
                <exclude>org.portable-scala:portable-scala-reflect_2.13</exclude>
                <exclude>org.scala-lang.modules:scala-collection-compat_2.13</exclude>
                <exclude>com.github.nawforce:scala-json-rpc_2.13</exclude>
                <exclude>com.github.nawforce:scala-json-rpc-upickle-json-serializer_2.13</exclude>
                <exclude>org.scala-js:scalajs-stubs_2.13</exclude>
                <exclude>org.scala-lang.modules:scala-parallel-collections_2.13</exclude>
                <exclude>org.scala-lang.modules:scala-xml_2.13</exclude>
                <exclude>com.lihaoyi:sourcecode_2.13</exclude>
                <exclude>org.scalameta:trees_2.13</exclude>
                <exclude>org.scalameta:trees2_2.13</exclude>
                <exclude>com.lihaoyi:ujson_2.13</exclude>
                <exclude>com.lihaoyi:upack_2.13</exclude>
                <exclude>com.lihaoyi:upickle_2.13</exclude>
                <exclude>com.lihaoyi:upickle-core_2.13</exclude>
                <exclude>com.lihaoyi:upickle-implicits_2.13</exclude>
            </excludes>
            <outputDirectory>lib/modules</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0644</fileMode>
            <useProjectArtifact>false</useProjectArtifact>
        </dependencySet>

        <!-- jar dependencies go to lib/classpath into the unnamed module -->
        <dependencySet>
            <scope>runtime</scope>
            <includes>
                <!-- pmd-ant stays on the classpath, see above -->
                <include>net.sourceforge.pmd:pmd-ant</include>

                <!-- include only dependencies not ready for module path yet -->
                <include>io.github.apex-dev-tools:apex-ls_2.13</include>
                <include>com.github.pathikrit:better-files_2.13</include>
                <include>org.scalameta:common_2.13</include>
                <include>org.scalameta:common2_2.13</include>
                <include>io.methvin:directory-watcher-better-files_2.13</include>
                <include>com.lihaoyi:geny_2.13</include>
                <include>org.scalameta:io_2.13</include>
                <include>com.lihaoyi:mainargs_2.13</include>
                <include>io.github.apex-dev-tools:outline-parser_2.13</include>
                <include>org.scalameta:parsers_2.13</include>
                <include>org.portable-scala:portable-scala-reflect_2.13</include>
                <include>org.scala-lang.modules:scala-collection-compat_2.13</include>
                <include>com.github.nawforce:scala-json-rpc_2.13</include>
                <include>com.github.nawforce:scala-json-rpc-upickle-json-serializer_2.13</include>
                <include>org.scala-js:scalajs-stubs_2.13</include>
                <include>org.scala-lang.modules:scala-parallel-collections_2.13</include>
                <include>org.scala-lang.modules:scala-xml_2.13</include>
                <include>com.lihaoyi:sourcecode_2.13</include>
                <include>org.scalameta:trees_2.13</include>
                <include>org.scalameta:trees2_2.13</include>
                <include>com.lihaoyi:ujson_2.13</include>
                <include>com.lihaoyi:upack_2.13</include>
                <include>com.lihaoyi:upickle_2.13</include>
                <include>com.lihaoyi:upickle-core_2.13</include>
                <include>com.lihaoyi:upickle-implicits_2.13</include>
            </includes>
            <outputDirectory>lib/classpath</outputDirectory>
            <directoryMode>0755</directoryMode>
            <fileMode>0644</fileMode>
            <useProjectArtifact>false</useProjectArtifact>
        </dependencySet>
    </dependencySets>
</assembly>
